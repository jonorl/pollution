{
  "name": "backend",
  "version": "1.0.0",
  "description": "Fastify API that stores the air-quality readings and serves them, raw and averaged",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "postinstall": "prisma generate",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "author": "Jonathan Orlowski",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.5.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
